# --- Database (PostgreSQL) ---
# Local: matches docker-compose.yml (npm run db:up).
DATABASE_URL="postgresql://cleanhome:cleanhome@localhost:5433/cleanhome"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://cleanhome:cleanhome@localhost:5433/cleanhome"

# --- Payments ---
# Local development: "mock" shows a fake payment page. It is NEVER offered in production.
# Production: leave this unset and set STRIPE_SECRET_KEY. Without a key, online payment is switched off.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Site ---
# Digits only, with country code, no "+". Inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_WHATSAPP_NUMBER="60123456789"
# Public URL of the site. On Vercel this is optional (the production URL is picked up automatically).
APP_URL="http://localhost:3000"
